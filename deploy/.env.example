# Copied to /opt/hevo/.env on each EC2 instance. Values differ between the
# dev and prod servers — see docs/DEPLOY.md. Not read by CI; lives only on
# the server, never committed with real values.

# --- Deploy-only vars (read by docker-compose.yml, not by Django) ---
IMAGE=<account-id>.dkr.ecr.us-east-2.amazonaws.com/hevo:dev   # prod: :prod
ECR_REGISTRY=<account-id>.dkr.ecr.us-east-2.amazonaws.com
SITE_DOMAIN=dev.hevo.ia.br                                    # prod: app.hevo.ia.br
ACME_EMAIL=you@example.com

# --- Django settings (same variables as the repo-root .env.example) ---
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=dev.hevo.ia.br                                  # prod: app.hevo.ia.br
DATABASE_URL=postgres://hevo:hevo@db:5432/hevo                # prod: RDS endpoint
REDIS_URL=redis://redis:6379/0
FIELD_ENCRYPTION_KEY=
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
FACEBOOK_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=lead_followup
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_FOLLOWUP_TEMPLATE_TEXT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=hevo-develop                          # prod: hevo-prod
AWS_S3_REGION_NAME=us-east-2
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@hevo.ia.br
SITE_URL=https://dev.hevo.ia.br                                # prod: https://app.hevo.ia.br
